{
  "name": "popup-lexicon",
  "version": "0.4.0",
  "description": "A multilingual dictionary and personal vocabulary manager for Obsidian with instant word lookup and local Markdown storage.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dictionary",
    "wiktionary",
    "definitions"
  ],
  "author": "Philippe Colling",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3",
    "yaml": "^2.9.1"
  },
  "contributors": [
    "Nikitas Tsiris (original Popup Dictionary)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/philcol33/popup-lexicon.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
